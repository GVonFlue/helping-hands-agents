# Set these in Railway → Variables. Never commit real values.

# agents_worker login (member of agent_service), Supabase session pooler. No password in the URL:
DATABASE_URL=postgresql://agents_worker.ylrfaqlxuxujyubjnqnz@aws-0-us-east-1.pooler.supabase.com:5432/postgres
# The password exactly as Garrett sent it (no encoding needed).
DATABASE_PASSWORD=
# Optional: Supabase's CA certificate (PEM) to verify the database TLS certificate
DATABASE_CA=
WORKER_ID=railway-worker-1

# Claude: drafts and the weekly report. Without it, drafts are blocked and reports use the template.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# ProyTech's own monthly spend ceilings, in cents (out of the $249). Not Francis's lookup cap.
AI_MONTHLY_CEILING_CENTS=4000
SEARCH_MONTHLY_CEILING_CENTS=2500

# Facebook search: leave empty until a provider is signed off (see README).
SEARCH_PROVIDER=serper
SERPER_API_KEY=
SEARCH_CENTS_PER_QUERY=0.1
# First live batch: 20. Raise to 100 once Francis's reviews look good.
FACEBOOK_DAILY_LIMIT=20
FACEBOOK_MIN_CONFIDENCE=0.6

# Skip trace (Tracerfy, batch). Billed to Francis's Scrub cap, which the worker checks before every paid call.
TRACERFY_API_KEY=
# Free test data first: https://mock.tracerfy.com (no charges, budget check skipped, records $0).
# Switch to https://tracerfy.com to go live.
TRACERFY_BASE=https://mock.tracerfy.com
SKIPTRACE_DAILY_LIMIT=20
SKIPTRACE_DNC=true
SKIPTRACE_FIRST_BAND=2501-10000
SKIP_BIG_COMPANY_DOORS=20
